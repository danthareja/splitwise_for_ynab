{
  "mcpServers": {
    "stripe": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp",
        "--tools=coupons.read,customers.read,products.read,prices.read,invoices.read,balance.read,paymentIntents.read,subscriptions.read,disputes.read,documentation.read",
        "--api-key=${MCP_STRIPE_API_KEY}"
      ]
    },
    "postgres-prod-readonly": {
      "command": "uvx",
      "args": ["postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${MCP_DATABASE_URL}"
      }
    },
    "postgres-dev": {
      "command": "uvx",
      "args": ["postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "postgresql://postgres:postgres@localhost:6969/postgres"
      }
    },
    "sentry": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@latest",
        "--access-token=${MCP_SENTRY_ACCESS_TOKEN}",
        "--host=danthareja.sentry.io"
      ]
    }
  }
}
